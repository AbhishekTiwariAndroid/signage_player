<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android while the process starts, before Flutter draws its first
     frame. Black rather than `?android:colorBackground` so the launch stays
     black whatever the device's light/dark setting is. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
</layer-list>
